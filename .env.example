# agent-discovery HTTP MCP server — local config
# Copy to .env (gitignored) and fill in.

# Bearer token Confluent Cloud uses to authenticate to this MCP server.
# Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=replace-me-with-a-strong-random-token

# Port to listen on locally. Default: 3000.
PORT=3000

# Bind address. Use 0.0.0.0 so ngrok can forward to the server.
HOST=0.0.0.0

# Where proposals are written. Defaults to <repo>/proposals.
# PROPOSALS_DIR=/absolute/path/to/proposals

# Root of the repo whose apm.yml the server reads. Defaults to cwd.
# SERVER_REPO_ROOT=/Users/you/code/some-target-repo

# ─── Kafka REST Proxy (used by scripts/seed-events.ts) ──────────────────

# From Confluent Cloud Cluster overview → "Endpoints":
KAFKA_REST_ENDPOINT=https://pkc-xxxx.us-east-2.aws.confluent.cloud:443

# From Cluster overview → cluster ID (lkc-…):
KAFKA_CLUSTER_ID=lkc-xxxxx

# Cluster API key/secret (Data Integration → API Keys → Create):
KAFKA_API_KEY=replace-me
KAFKA_API_SECRET=replace-me

# Topic name. Default if unset: project_events
KAFKA_TOPIC=project_events
